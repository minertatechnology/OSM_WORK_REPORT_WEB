# syntax=docker/dockerfile:1
FROM oven/bun:1 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

FROM oven/bun:1 AS builder
WORKDIR /app

# Build-time environment variables
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_LOCALE
ARG NEXT_PUBLIC_ENV_MODE
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_CLIENT_ID
ARG NEXT_PUBLIC_DEBUG_MODE
ARG NEXT_PUBLIC_EXPORT_MODE
ARG ENV_MODE
ARG EXPORT_MODE
ARG NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS
ARG NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS
ARG LOGIN_THIRD_PARTY_ENABLED
ARG EXPO_PUBLIC_THIRD_PARTY_API_URL
ARG EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID
ARG EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED
ARG LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID
ARG NEXT_PUBLIC_API_BASE_SMART_OSM_URL

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_LOCALE=$NEXT_PUBLIC_LOCALE
ENV NEXT_PUBLIC_ENV_MODE=$NEXT_PUBLIC_ENV_MODE
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_CLIENT_ID=$NEXT_PUBLIC_CLIENT_ID
ENV NEXT_PUBLIC_DEBUG_MODE=$NEXT_PUBLIC_DEBUG_MODE
ENV NEXT_PUBLIC_EXPORT_MODE=$NEXT_PUBLIC_EXPORT_MODE
ENV ENV_MODE=$ENV_MODE
ENV EXPORT_MODE=$EXPORT_MODE
ENV NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS=$NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS
ENV NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS=$NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS
ENV LOGIN_THIRD_PARTY_ENABLED=$LOGIN_THIRD_PARTY_ENABLED
ENV EXPO_PUBLIC_THIRD_PARTY_API_URL=$EXPO_PUBLIC_THIRD_PARTY_API_URL
ENV EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID=$EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID
ENV EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED=$EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED
ENV LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID=$LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID
ENV NEXT_PUBLIC_API_BASE_SMART_OSM_URL=$NEXT_PUBLIC_API_BASE_SMART_OSM_URL

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN bun run build

FROM oven/bun:1 AS runner
WORKDIR /app

# Runtime environment variables
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_LOCALE
ARG NEXT_PUBLIC_ENV_MODE
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_CLIENT_ID
ARG NEXT_PUBLIC_DEBUG_MODE
ARG NEXT_PUBLIC_EXPORT_MODE
ARG ENV_MODE
ARG EXPORT_MODE
ARG NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS
ARG NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS
ARG LOGIN_THIRD_PARTY_ENABLED
ARG EXPO_PUBLIC_THIRD_PARTY_API_URL
ARG EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID
ARG EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED
ARG LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID
ARG NEXT_PUBLIC_API_BASE_SMART_OSM_URL

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_LOCALE=$NEXT_PUBLIC_LOCALE
ENV NEXT_PUBLIC_ENV_MODE=$NEXT_PUBLIC_ENV_MODE
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_CLIENT_ID=$NEXT_PUBLIC_CLIENT_ID
ENV NEXT_PUBLIC_DEBUG_MODE=$NEXT_PUBLIC_DEBUG_MODE
ENV NEXT_PUBLIC_EXPORT_MODE=$NEXT_PUBLIC_EXPORT_MODE
ENV ENV_MODE=$ENV_MODE
ENV EXPORT_MODE=$EXPORT_MODE
ENV NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS=$NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS
ENV NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS=$NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS
ENV LOGIN_THIRD_PARTY_ENABLED=$LOGIN_THIRD_PARTY_ENABLED
ENV EXPO_PUBLIC_THIRD_PARTY_API_URL=$EXPO_PUBLIC_THIRD_PARTY_API_URL
ENV EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID=$EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID
ENV EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED=$EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED
ENV LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID=$LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID
ENV NEXT_PUBLIC_API_BASE_SMART_OSM_URL=$NEXT_PUBLIC_API_BASE_SMART_OSM_URL

COPY --from=builder /app ./
EXPOSE 3000
CMD ["bun", "run", "start"]
