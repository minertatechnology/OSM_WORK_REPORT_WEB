# สำหรับ client
NEXT_PUBLIC_APP_NAME="OSM WORK REPORT" 
NEXT_PUBLIC_LOCALE= 
NEXT_PUBLIC_ENV_MODE= 
NEXT_PUBLIC_API_BASE_URL=https://api-thaiphc.hss.moph.go.th/api/v1
NEXT_PUBLIC_CLIENT_ID=1fb6e163-f9d7-4bc5-8729-f6b97ee89983 
NEXT_PUBLIC_DEBUG_MODE=true 
NEXT_PUBLIC_EXPORT_MODE= 

# ---------- Token Refresh Configuration ----------
# Refresh token ก่อนหมดอายุ (วินาที) - ค่าเริ่มต้น: 60 วินาที (1 นาที)
NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD_SECONDS=60 

# จะ refresh token ล่วงหน้าเมื่อผู้ใช้กำลังใช้งานและเหลือเวลาน้อยกว่า 5 นาที
NEXT_PUBLIC_INTERACTION_REFRESH_BUFFER_SECONDS=300 

# ---------- Third-party OAuth2 ----------
LOGIN_THIRD_PARTY_ENABLED=true 
EXPO_PUBLIC_THIRD_PARTY_API_URL=https://api-thaiphc.hss.moph.go.th/api/v1 
EXPO_PUBLIC_THIRD_PARTY_CLIENT_ID=1fb6e163-f9d7-4bc5-8729-f6b97ee89983 
EXPO_PUBLIC_LOGIN_THIRD_PARTY_ENABLED=true 
LOGIN_THIRD_PARTY_PUBLIC_CLIENT_ID=1fb6e163-f9d7-4bc5-8729-f6b97ee89983 

#---------- smart osm base ----------
NEXT_PUBLIC_API_BASE_SMART_OSM_URL=https://api-smartosm.hss.moph.go.th/api/v1

# สำหรับ next.config.js (server-side) 
ENV_MODE= 
EXPORT_MODE= 